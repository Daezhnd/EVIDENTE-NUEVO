generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model articles {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title        String
  slug         String           @unique
  summary      String
  content      String
  image_url    String?
  category     article_category
  author_id    String?          @db.Uuid
  is_published Boolean?         @default(false)
  views_count  Int?             @default(0)
  published_at DateTime?        @db.Timestamptz(6)
  created_at   DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?        @default(now()) @db.Timestamptz(6)
  users        users?           @relation(fields: [author_id], references: [id], onUpdate: NoAction)

  @@index([category], map: "idx_articles_category")
  @@index([published_at(sort: Desc)], map: "idx_articles_published")
  @@index([slug], map: "idx_articles_slug")
}

model reels {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  video_url     String
  thumbnail_url String?
  caption       String?
  author_id     String?   @db.Uuid
  is_published  Boolean?  @default(false)
  views_count   Int?      @default(0)
  likes_count   Int?      @default(0)
  published_at  DateTime? @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users?    @relation(fields: [author_id], references: [id], onUpdate: NoAction)
}

model users {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String     @unique
  password_hash String
  full_name     String?
  avatar_url    String?
  role          user_role? @default(viewer)
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?  @default(now()) @db.Timestamptz(6)
  articles      articles[]
  reels         reels[]
}

enum article_category {
  Destacadas
  Noticias
  Deportes
  Turismo
}

enum user_role {
  admin
  editor
  viewer
}
